COPY (
    WITH candidates AS (
        SELECT array_agg(c) AS arr
        FROM public.evoke_hybrid_bm25_candidates(
            'tokens',
            'bm25_it.docs_tokens_bm25_idx'::regclass,
            'bird',
            2.0,
            3
        ) AS c
    )
    SELECT
        d.id::text,
        round(h.score::numeric, 6)::text,
        h.source_names::text,
        h.ranks::text
    FROM candidates
    CROSS JOIN LATERAL public.evoke_hybrid_fuse_candidates(
        candidates.arr,
        3,
        'rrf'
    ) AS h
    JOIN bm25_it.docs_tokens d ON d.ctid = h.ctid
    ORDER BY h.score DESC, d.id
) TO STDOUT;
