RESET enable_seqscan;
CREATE TABLE docs_text_scalar_default (
    id int primary key,
    content text not null
);
INSERT INTO docs_text_scalar_default VALUES
    (1, 'Cat bird'),
    (2, 'dog friend'),
    (3, 'CAT');
CREATE INDEX docs_text_scalar_default_bm25_idx
    ON docs_text_scalar_default USING evoke (content);
DO $$
BEGIN
    BEGIN
        EXECUTE
            'CREATE INDEX docs_text_invalid_b_idx '
            || 'ON docs_text_scalar_default USING evoke (content) '
            || 'WITH (b = 1.01)';
        RAISE EXCEPTION 'evoke accepted b outside the BM25 domain';
    EXCEPTION WHEN invalid_parameter_value THEN
        NULL;
    END;
    BEGIN
        EXECUTE
            'CREATE INDEX docs_text_invalid_k1_idx '
            || 'ON docs_text_scalar_default USING evoke (content) '
            || 'WITH (k1 = 3.5e38)';
        RAISE EXCEPTION 'evoke accepted k1 that cannot fit in real';
    EXCEPTION WHEN invalid_parameter_value THEN
        NULL;
    END;
    BEGIN
        EXECUTE
            'CREATE INDEX docs_text_invalid_delta_idx '
            || 'ON docs_text_scalar_default USING evoke (content) '
            || 'WITH (delta = 3.5e38)';
        RAISE EXCEPTION 'evoke accepted delta that cannot fit in real';
    EXCEPTION WHEN invalid_parameter_value THEN
        NULL;
    END;
    BEGIN
        EXECUTE
            'CREATE INDEX docs_text_invalid_nan_k1_idx '
            || 'ON docs_text_scalar_default USING evoke (content) '
            || 'WITH (k1 = ''NaN'')';
        RAISE EXCEPTION 'evoke accepted non-finite k1';
    EXCEPTION WHEN invalid_parameter_value THEN
        NULL;
    END;
    BEGIN
        EXECUTE
            'CREATE INDEX docs_text_retired_churn_idx '
            || 'ON docs_text_scalar_default USING evoke (content) '
            || 'WITH (auto_rebuild_churn_ratio = 0.1)';
        RAISE EXCEPTION 'evoke accepted retired churn reloption';
    EXCEPTION WHEN invalid_parameter_value THEN
        NULL;
    END;
    BEGIN
        EXECUTE
            'CREATE INDEX docs_text_retired_overlay_records_idx '
            || 'ON docs_text_scalar_default USING evoke (content) '
            || 'WITH (query_overlay_max_records = 1)';
        RAISE EXCEPTION 'evoke accepted retired overlay-record reloption';
    EXCEPTION WHEN invalid_parameter_value THEN
        NULL;
    END;
    BEGIN
        EXECUTE
            'CREATE INDEX docs_text_retired_overlay_bytes_idx '
            || 'ON docs_text_scalar_default USING evoke (content) '
            || 'WITH (query_overlay_max_bytes = 1)';
        RAISE EXCEPTION 'evoke accepted retired overlay-byte reloption';
    EXCEPTION WHEN invalid_parameter_value THEN
        NULL;
    END;
END;
$$;
