COPY (
    SELECT doc_ids, ARRAY(
        SELECT round(value::double precision::numeric, 6)::text
        FROM unnest(scores) WITH ORDINALITY AS score(value, position)
        ORDER BY position
    ) AS scores
    FROM bm25_it.search_ids(
        'bm25_it.docs_ids_auto_bm25_idx'::regclass,
        ARRAY[0,2],
        3,
        NULL
    )
) TO STDOUT;
