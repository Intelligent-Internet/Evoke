CREATE EXTENSION evoke WITH SCHEMA public;
CREATE SCHEMA bm25_it;
SET search_path = bm25_it, public;
COPY (
    SELECT evoke_packaged_model_path_internal()
        LIKE '%/evoke/models/default'
) TO STDOUT;
t
COPY (
    SELECT count(*)::text
    FROM pg_proc p
    JOIN pg_namespace n
        ON n.oid = p.pronamespace
    WHERE n.nspname = 'public'
      AND p.proname IN (
        'evoke_hybrid_check_direction',
        'evoke_hybrid_check_fusion',
        'evoke_hybrid_check_normalizer',
        'evoke_hybrid_fuse_candidates_sql_reference',
        'evoke_fuse_results',
        'evoke_hits',
        'evoke_match_query_tokens',
        'evoke_query_hits',
        'evoke_score_query_tokens'
      )
) TO STDOUT;
0
COPY (
    SELECT count(*)::text
    FROM pg_type t
    JOIN pg_namespace n
        ON n.oid = t.typnamespace
    WHERE n.nspname = 'public'
      AND t.typname = 'evoke_result'
) TO STDOUT;
0
COPY (
    SELECT count(*)::text
    FROM pg_proc p
    JOIN pg_namespace n
        ON n.oid = p.pronamespace
    WHERE n.nspname = 'public'
      AND p.proname = 'evoke_query'
      AND pg_get_function_identity_arguments(p.oid)
          = 'regclass, text, boolean, text[], boolean, boolean'
) TO STDOUT;
