        'bm25_it.docs_text_segment_reuse_bm25_idx'::regclass
    );
END;
$$;
DO $$
BEGIN
    PERFORM public.evoke_index_maintain(
        'bm25_it.docs_text_segment_reuse_bm25_idx'::regclass
    );
END;
$$;
COPY (
