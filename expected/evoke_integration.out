    hits AS (
        SELECT d.id
        FROM public.evoke_query(
            'bm25_it.docs_eventual_large_delta_policy_bm25_idx'::regclass,
            'oversized',
            10
        ) h
        JOIN bm25_it.docs_eventual_large_delta_policy d
