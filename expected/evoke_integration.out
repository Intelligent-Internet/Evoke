SELECT d.id, round(h.score::numeric, 6)::text AS score
FROM public.evoke_query_ids(
    'bm25_it.docs_ids_auto_bm25_idx'::regclass,
    ARRAY[0,2],
    3,
    NULL
) h
JOIN bm25_it.docs_ids_auto d ON d.ctid = h.ctid
ORDER BY h.score DESC, d.id;
