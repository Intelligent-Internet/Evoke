#!/usr/bin/env bash

set -euo pipefail

# ORT 1.29 can emit POSIX telemetry when its build enables that feature. Evoke
# runtime workers disable it unless the operator explicitly opted in.
export ORT_DISABLE_TELEMETRY=${ORT_DISABLE_TELEMETRY:-1}

model_path=${EVOKE_MODEL_PATH:-/usr/local/share/evoke/models/default}
checkout_signature=${EVOKE_CHECKOUT_SIGNATURE:-}
runtime_precision=${EVOKE_RUNTIME_PRECISION:-fp16}
http_workers=${EVOKE_HTTP_WORKER_COUNT:-4}
http_queue_depth=${EVOKE_HTTP_QUEUE_DEPTH:-}
http_host=${EVOKE_HTTP_HOST:-0.0.0.0}
http_port=${EVOKE_HTTP_PORT:-8042}
max_batch_size=${EVOKE_MAX_BATCH_SIZE:-128}
max_delay_ms=${EVOKE_MAX_DELAY_MS:-5}
max_request_bytes=${EVOKE_MAX_REQUEST_BYTES:-67108864}
intra_op_threads=${EVOKE_INTRA_OP_THREADS:-}

case "$checkout_signature" in
    ''|*[!0-9a-fA-F]*)
        cat >&2 <<'MSG'
EVOKE_CHECKOUT_SIGNATURE is required.

The direct accelerator does not have PostgreSQL available to reconstruct the
extension checkout identity. Pass the signature produced by the coordinator
database for the exact model checkout before accepting /v1/encode traffic.
MSG
        exit 1
        ;;
esac
if [ "${#checkout_signature}" -ne 64 ]; then
    echo "EVOKE_CHECKOUT_SIGNATURE must be 64 hex chars" >&2
    exit 1
fi

for item in \
    "EVOKE_HTTP_WORKER_COUNT:$http_workers" \
    "EVOKE_HTTP_PORT:$http_port" \
    "EVOKE_MAX_BATCH_SIZE:$max_batch_size" \
    "EVOKE_MAX_DELAY_MS:$max_delay_ms" \
    "EVOKE_MAX_REQUEST_BYTES:$max_request_bytes"
do
    name=${item%%:*}
    value=${item#*:}
    case "$value" in
        ''|*[!0-9]*)
            echo "$name must be a positive integer" >&2
            exit 1
            ;;
    esac
done

server_args=(
    evoke-runtime-server
    --model-path "$model_path"
    --checkout-signature "$checkout_signature"
    --runtime-precision "$runtime_precision"
    --host "$http_host"
    --port "$http_port"
    --max-batch-size "$max_batch_size"
    --max-delay-ms "$max_delay_ms"
    --max-request-bytes "$max_request_bytes"
    --worker-count "$http_workers"
)

case "$http_queue_depth" in
    '')
        ;;
    *[!0-9]*)
        echo "EVOKE_HTTP_QUEUE_DEPTH must be a positive integer" >&2
        exit 1
        ;;
    *)
        server_args+=(--max-queue-depth "$http_queue_depth")
        ;;
esac

case "$intra_op_threads" in
    '')
        ;;
    *[!0-9]*)
        echo "EVOKE_INTRA_OP_THREADS must be a positive integer" >&2
        exit 1
        ;;
    *)
        server_args+=(--intra-op-threads "$intra_op_threads")
        ;;
esac

exec "${server_args[@]}"
